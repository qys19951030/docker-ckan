# Runtime configuration of CKAN enabled through ckanext-envvars
# Information about how it works: https://github.com/okfn/ckanext-envvars
# Note that variables here take presedence over build/up time variables in .env
#
# === Session / JWT Secret Configuration ===
#
# The following 3 variables control CKAN session and API token signing.
# They are consumed by BOTH the container startup script (start_ckan.sh) and the
# ckanext-envvars plugin. For stable deployments you MUST replace CHANGE_ME
# values with strong random secrets. If you leave them as CHANGE_ME (or unset),
# the container will generate a random secret at startup (which means sessions
# and tokens are invalidated on every container restart).
#
#   CKAN___BEAKER__SESSION__SECRET
#       Session cookie signing secret. Replace with a long random string.
#       Do NOT prefix with "string:".
#       Example:  CKAN___BEAKER__SESSION__SECRET=abc123xyz...
#
#   CKAN___API_TOKEN__JWT__ENCODE__SECRET
#       Secret used to SIGN (encode) API tokens. Prefix the raw value with
#       "string:" so CKAN's JWT layer treats it as a plain shared secret.
#       Example:  CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:my-jwt-secret
#
#   CKAN___API_TOKEN__JWT__DECODE__SECRET
#       Secret used to VERIFY (decode) API tokens. 99% of deployments should
#       use the SAME value as the encode secret (also prefixed with "string:").
#       Example:  CKAN___API_TOKEN__JWT__DECODE__SECRET=string:my-jwt-secret
#
# For backwards compatibility the startup script also accepts the legacy names
# BEAKER_SESSION_SECRET, JWT_ENCODE_SECRET, JWT_DECODE_SECRET but the names
# above (CKAN___* style) are preferred because they match ckanext-envvars.
# ==========================================================================

#Compose variables
# CKAN
CKAN_MAX_UPLOAD_SIZE_MB=10
CKAN_SQLALCHEMY_URL=postgresql://ckan:${POSTGRES_PASSWORD:-ckan}@db/ckan
CKAN_DATASTORE_WRITE_URL=postgresql://ckan:${POSTGRES_PASSWORD:-ckan}@db/datastore
CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:${DATASTORE_READONLY_PASSWORD:-datastore}@db/datastore
CKAN_SOLR_URL=http://solr:8983/solr/ckan
CKAN_REDIS_URL=redis://redis:6379/1


# Set to true to disable CKAN from starting and serve a maintenance page
MAINTENANCE_MODE=false

# General Settings
CKAN_SITE_ID=default
CKAN_SITE_URL=http://localhost:5000
CKAN_PORT=5000
CKAN___BEAKER__SESSION__SECRET=CHANGE_ME
# See https://docs.ckan.org/en/latest/maintaining/configuration.html#api-token-settings
CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:CHANGE_ME
CKAN___API_TOKEN__JWT__DECODE__SECRET=string:CHANGE_ME
# CKAN Plugins
CKAN__PLUGINS=envvars activity image_view text_view datatables_view datastore xloader
# CKAN requires storage path to be set in order for filestore to be enabled
CKAN__STORAGE_PATH=/app/data
CKAN__WEBASSETS__PATH=/app/data/webassets
# Enable file uploads in datasets
CKAN__UPLOADS_ENABLED=true
# SYSADMIN settings, a sysadmin user is created automatically with the below credentials
CKAN_SYSADMIN_NAME=sysadmin
CKAN_SYSADMIN_PASSWORD=password
CKAN_SYSADMIN_EMAIL=sysadmin@ckantest.com

# Email settings
CKAN_SMTP_SERVER=smtp.corporateict.domain:25
CKAN_SMTP_STARTTLS=True
CKAN_SMTP_USER=user
CKAN_SMTP_PASSWORD=pass
CKAN_SMTP_MAIL_FROM=ckan@localhost
